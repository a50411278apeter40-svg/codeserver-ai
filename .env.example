# =============================================================================
# codeserver-ai environment variables
# Copy this file to .env (local dev) or set these in the Render dashboard.
# =============================================================================

# --- Gemini AI chat ---
# Google Gemini / Generative Language API key (Google AI Studio).
# Preferred name: GOOGLE_API_KEY (also accepts GEMINI_API_KEY as a fallback).
GOOGLE_API_KEY=

# Gemini model to use for chat (Gemma 4 model family).
GEMINI_MODEL=gemma-4-31b-it

# --- GitHub Codespaces sandbox ---
# GitHub Personal Access Token (classic) or fine-grained token.
# Requires scopes: repo (full) and codespace (read/write).
GITHUB_TOKEN=

# The template repository Codespaces are created from (owner/repo).
# Create a repo with a devcontainer.json; Codespaces clone from it.
GITHUB_SANDBOX_REPO=owner/repo

# Machine type for new codespaces. Use GET /api/codespaces/machines to see
# what's actually available for your repo/plan. Default is the highest tier.
CODESPACE_MACHINE_TYPE=largePremiumLinux

# --- Internal (usually don't change) ---
# Port the Node backend listens on (Render injects PORT automatically).
PORT=10000

# Internal code-server address (runs inside the same container).
CODE_SERVER_TARGET=http://127.0.0.1:8080
